# ─── Generic OpenAI-compatible provider (takes precedence when set) ────────────
# Point to any OpenAI-compatible endpoint: Groq, OpenRouter, OmniRoute, Ollama, etc.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.1-8b-instant
# Optional rate-limit overrides (requests per minute / per day)
# LLM_RPM=30
# LLM_RPD=14400

# ─── Provider-specific keys (used as fallback when LLM_BASE_URL is not set) ───
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_URL=http://localhost:11434/api/chat

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
