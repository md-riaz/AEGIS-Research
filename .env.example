# ─── Generic OpenAI-compatible provider (takes precedence when set) ────────────
# Point to any OpenAI-compatible endpoint: Groq, OpenRouter, OmniRoute, Ollama, etc.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.1-8b-instant
# Optional rate-limit overrides (requests per minute / per day)
# LLM_RPM=30
# LLM_RPD=14400

# Optional local/Docker ports
AEGIS_PORT=8765
AEGIS_MYSQL_PORT=3307

# ─── Provider-specific keys (used as fallback when LLM_BASE_URL is not set) ───
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_URL=http://localhost:11434/api/chat

# ─── Database ──────────────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aegis
MYSQL_USER=root
MYSQL_PASSWORD=
