  "58b7f779b2eafeeb": {
    "widget_id": "58b7f779b2eafeeb",
    "original_query": "Compare revenue across product categories",
    "plan": {
      "pattern": "comparison",
      "metric": "revenue",
      "dimension": "category_name",
      "time_rule": null,
      "join_path": [
        "Category",
        "Order",
        "Product_Category_Mapping"
      ],
      "filters": [],
      "sort": "desc",
      "limit": null,
      "visual": "grouped_bar"
    },
    "sql_hash": "f6e25d6e62fabe7e1452c49d14cd33d9578a6eb0199d951fd00d911a7815d4d6",
    "compiled_sql": "SELECT c.Name AS label, SUM(o.OrderTotal - o.RefundedAmount) AS value\nFROM [Order] o\nINNER JOIN [OrderItem] oi ON o.Id = oi.OrderId\nINNER JOIN [Product] p ON oi.ProductId = p.Id\nINNER JOIN [Product_Category_Mapping] pcm ON p.Id = pcm.ProductId\nINNER JOIN [Category] c ON pcm.CategoryId = c.Id\nWHERE 1=1\nGROUP BY c.Name\nORDER BY value desc",
    "visualization": {
      "chart_type": "grouped_bar",
      "title": "Revenue by Category Name",
      "x_axis": "Category Name",
      "y_axis": "Revenue",
      "series_key": "category_name",
      "color_scheme": "default",
      "options": {
        "default_sort": "desc"
      }
    },
