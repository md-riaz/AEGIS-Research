  "a743a3e81339eada": {
    "widget_id": "a743a3e81339eada",
    "original_query": "Show top 5 products by revenue",
    "plan": {
      "pattern": "ranking",
      "metric": "revenue",
      "dimension": "product_name",
      "time_rule": null,
      "join_path": [
        "Order",
        "Product"
      ],
      "filters": [],
      "sort": "desc",
      "limit": 5,
      "visual": "bar_chart"
    },
    "sql_hash": "42495c4650aa750632b147f2531a7d3596ea0363e8c0da51358a9dc377ac738a",
    "compiled_sql": "SELECT p.Name AS label, SUM(o.OrderTotal - o.RefundedAmount) AS value\nFROM [Order] o\nINNER JOIN [OrderItem] oi ON o.Id = oi.OrderId\nINNER JOIN [Product] p ON oi.ProductId = p.Id\nWHERE 1=1\nGROUP BY p.Name\nORDER BY value desc\nOFFSET 0 ROWS FETCH NEXT 5 ROWS ONLY",
    "visualization": {
      "chart_type": "bar_chart",
      "title": "Top 5 Product Name by Revenue",
      "x_axis": "Product Name",
      "y_axis": "Revenue",
      "series_key": "product_name",
      "color_scheme": "default",
      "options": {
        "orientation": "horizontal",
        "sort_by_value": true,
        "default_sort": "desc"
      }
    },
