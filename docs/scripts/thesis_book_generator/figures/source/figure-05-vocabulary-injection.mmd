flowchart TB
    Q["Original user question"]
    SL["Semantic layer vocabulary<br/>approved metrics and dimensions"]
    PB["Prompt context<br/>vocabulary injected"]
    LLM["LLM parser"]
    INT["Intent Object<br/>uses approved identifiers"]
    SC["Schema validation<br/>JSON contract"]
    COV["Intent Object validation<br/>approved bindings"]
    RAW["Narrow raw-text cues<br/>writes, secrets, prediction"]
    OK["Continue to semantic mapping"]
    REJ["Clarify or reject<br/>unsupported wording"]

    SL --> PB --> LLM --> INT --> SC
    Q --> LLM
    Q --> RAW --> COV
    COV --> OK
    SC --> OK
    COV -. boundary found .-> REJ
    SC -. malformed .-> REJ

    NOTE["Key rule<br/>LLM normalizes vague language;<br/>AEGIS validates the Intent Object"]
    INT --> NOTE --> COV

    classDef question fill:#f3f4f6,stroke:#64748b,color:#111827,stroke-width:2px;
    classDef semantic fill:#dcfce7,stroke:#15803d,color:#111827,stroke-width:2px;
    classDef prompt fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px;
    classDef llm fill:#ede9fe,stroke:#6d28d9,color:#111827,stroke-width:2px;
    classDef validation fill:#fef3c7,stroke:#b45309,color:#111827,stroke-width:2px;
    classDef reject fill:#fee2e2,stroke:#b91c1c,color:#111827,stroke-width:2px;

    class Q question;
    class SL semantic;
    class PB,INT prompt;
    class LLM llm;
    class SC,COV,OK,NOTE validation;
    class REJ reject;
