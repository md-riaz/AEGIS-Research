%% AEGIS thesis Figure 3 source
%% Layout note: every edge between stages attaches to the subgraph id
%% (AI, GOV, DET, OUT), never to a node inside it. Mermaid ignores a
%% subgraph direction as soon as a node inside it has an edge crossing the
%% subgraph boundary, and the stage rows then collapse into one tall column
%% with no error raised. Writing GOV --> DET as S --> P renders fine and
%% silently breaks the layout.
%%{init: {"theme": "base", "themeCSS": ".nodeLabel, .edgeLabel, .cluster-label { font-family: Arial, sans-serif !important; } .nodeLabel { font-size: 16px; } .edgeLabel { font-size: 14px; } .cluster-label { font-weight: 700; }", "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryTextColor": "#111827", "lineColor": "#64748b"}, "flowchart": {"nodeSpacing": 42, "rankSpacing": 52, "curve": "linear", "padding": 16}}}%%
flowchart TB
    U["User request<br/>(natural language)"]

    subgraph AI["Language understanding only"]
      direction LR
      L["LLM parser<br/>outputs an Intent Object<br/>no SQL field"]
    end

    subgraph GOV["Approved semantic boundary"]
      direction LR
      C["Intent Object validation<br/>approved bindings"]
      G["Grounding check<br/>metric, dimension, filters"]
      S["Semantic mapping<br/>business definitions"]
      C --> G --> S
    end

    subgraph DET["Deterministic execution path"]
      direction LR
      P["Permission rewriting"]
      Q["Template SQL compiler"]
      V["Safety scanner"]
      E["Read-only execution"]
      P --> Q --> V --> E
    end

    subgraph OUT["Reusable reporting artifact"]
      direction LR
      CH["Chart selector"]
      W["Widget store"]
      D["Dashboard widget"]
      CH --> W --> D
    end

    R["Clarify or reject<br/>no silent fallback"]

    U --> AI
    AI --> GOV
    GOV --> DET
    DET --> OUT

    GOV -. unsupported, unsafe scope, or ambiguous .-> R
    DET -. unsafe SQL .-> R

    classDef user fill:#f3f4f6,stroke:#64748b,color:#111827,stroke-width:2px;
    classDef ai fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px;
    classDef Approved fill:#dcfce7,stroke:#15803d,color:#111827,stroke-width:2px;
    classDef deterministic fill:#fef3c7,stroke:#b45309,color:#111827,stroke-width:2px;
    classDef output fill:#ede9fe,stroke:#6d28d9,color:#111827,stroke-width:2px;
    classDef reject fill:#fee2e2,stroke:#b91c1c,color:#111827,stroke-width:2px;

    class U user;
    class L ai;
    class C,G,S Approved;
    class P,Q,V,E deterministic;
    class CH,W,D output;
    class R reject;
