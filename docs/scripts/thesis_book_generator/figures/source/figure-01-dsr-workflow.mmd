%% AEGIS thesis Figure 1 source
%% Layout note: the edges into and out of the cycles attach to the subgraph
%% id (CYCLES), never to C1 or C3. Mermaid ignores a subgraph direction as
%% soon as a node inside it has an edge crossing the subgraph boundary, and
%% the three cycles then sit side by side in one long row with no error
%% raised. Writing A --> CYCLES as A --> C1 renders fine and silently
%% breaks the layout.
%%{init: {"theme": "base", "themeCSS": ".nodeLabel, .edgeLabel, .cluster-label { font-family: Arial, sans-serif !important; } .nodeLabel { font-size: 17px; } .cluster-label { font-weight: 700; }", "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryTextColor": "#111827", "lineColor": "#475569"}, "flowchart": {"nodeSpacing": 44, "rankSpacing": 54, "curve": "linear", "padding": 16}}}%%
flowchart LR
    P["Problem identification<br/>self-service analytics<br/>and SQL safety"]
    A["Artifact design<br/>semantic layer<br/>and compiler boundary"]

    subgraph CYCLES["Build and evaluation cycles"]
      direction TB
      C1["Cycle 1<br/>semantic layer<br/>and compiler"]
      C2["Cycle 2<br/>analytics patterns<br/>and vocabulary injection"]
      C3["Cycle 3<br/>widget persistence<br/>and static benchmarks"]
      C1 --> C2 --> C3
    end

    E["Evaluation<br/>coverage, safety,<br/>fidelity and limits"]
    T["Thesis contribution<br/>bounded natural-language<br/>analytics architecture"]

    P --> A --> CYCLES
    CYCLES --> E --> T

    classDef problem fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px;
    classDef design fill:#dcfce7,stroke:#14532d,color:#111827,stroke-width:2px;
    classDef cycle fill:#fff7ed,stroke:#c2410c,color:#111827,stroke-width:2px;
    classDef eval fill:#ede9fe,stroke:#4c1d95,color:#111827,stroke-width:2px;
    classDef output fill:#f8fafc,stroke:#64748b,color:#111827,stroke-width:2px;

    class P problem;
    class A design;
    class C1,C2,C3 cycle;
    class E eval;
    class T output;
