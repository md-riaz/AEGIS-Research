flowchart LR
    Q["New natural-language<br/>question"]
    PIPE["AEGIS pipeline<br/>intent, coverage,<br/>compile, visualize"]
    PLAN["Canonical plan<br/>+ hash"]
    DEC{"Known hash?"}
    REUSE["Return existing widget"]
    SAVE["Save new widget<br/>SQL template hash<br/>chart config<br/>access rules"]
    DASH["Dashboard"]
    REF["Scheduled refresh<br/>stored safe query<br/>fresh data"]

    Q --> PIPE --> PLAN --> DEC
    DEC -- "Yes" --> REUSE
    DEC -- "No" --> SAVE
    REUSE --> DASH
    SAVE --> DASH
    DASH --> REF --> DASH

    classDef start fill:#f3f4f6,stroke:#64748b,color:#111827,stroke-width:2px;
    classDef process fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px;
    classDef decision fill:#fef3c7,stroke:#b45309,color:#111827,stroke-width:2px;
    classDef store fill:#dcfce7,stroke:#15803d,color:#111827,stroke-width:2px;
    classDef refresh fill:#ede9fe,stroke:#6d28d9,color:#111827,stroke-width:2px;

    class Q,DASH start;
    class PIPE,PLAN,HASH process;
    class DEC decision;
    class REUSE,SAVE store;
    class REF refresh;
